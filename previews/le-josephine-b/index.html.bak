</nav>

<script>
(function(){
  /* Reveal on scroll — content is visible by default if JS or the observer is unavailable */
  var els=document.querySelectorAll('.reveal');
  if('IntersectionObserver' in window){
    var io=new IntersectionObserver(function(entries){
      entries.forEach(function(x){if(x.isIntersecting){x.target.classList.add('in');io.unobserve(x.target);}});
    },{threshold:.12,rootMargin:'0px 0px -40px 0px'});
    els.forEach(function(el){io.observe(el)});
    setTimeout(function(){els.forEach(function(el){el.classList.add('in')})},4000);
  }else{els.forEach(function(el){el.classList.add('in')})}

  /* Open / closed now (Nantes time) + highlight today */
  try{
    var parts=new Intl.DateTimeFormat('en-GB',{timeZone:'Europe/Paris',weekday:'short',hour:'2-digit',minute:'2-digit',hourCycle:'h23'}).formatToParts(new Date());
    var get=function(t){var p=parts.find(function(x){return x.type===t});return p?p.value:''};
    var day={Sun:0,Mon:1,Tue:2,Wed:3,Thu:4,Fri:5,Sat:6}[get('weekday')];
    var mins=parseInt(get('hour'),10)*60+parseInt(get('minute'),10);
    var H={0:[[540,1020]],1:[[720,900]],2:[[720,900]],3:[[720,900]],4:[[720,900]],5:[[720,900],[1140,1380]],6:[[1140,1380]]};
    var row=document.querySelector('#hours tr[data-d="'+day+'"]');if(row)row.classList.add('today');
    var fmt=function(m){var h=Math.floor(m/60),mm=m%60;return h+' h'+(mm?(mm<10?'0':'')+mm:'')};
    var st=document.getElementById('status'),txt=st.querySelector('span'),open=null,next=null;
    (H[day]||[]).forEach(function(s){if(mins>=s[0]&&mins<s[1])open=s;else if(mins<s[0]&&!next)next=s;});
    if(open){st.classList.add('open');txt.textContent='Ouvert maintenant · jusqu\u2019à '+fmt(open[1]);}
    else{st.classList.add('closed');txt.textContent=next?'Fermé pour le moment · ouverture à '+fmt(next[0]):'Fermé pour le moment · voir les horaires';}
  }catch(e){}

  /* Install the app (only shown where the browser offers it, e.g. Android) */
  var dp,btn=document.getElementById('install');
  addEventListener('beforeinstallprompt',function(e){e.preventDefault();dp=e;btn.classList.add('show');});
  btn.addEventListener('click',function(){if(!dp)return;dp.prompt();dp.userChoice.finally(function(){dp=null;btn.classList.remove('show');});});
  addEventListener('appinstalled',function(){btn.classList.remove('show');});
})();
</script>
</body>
</html>